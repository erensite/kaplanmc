# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Başvuruların düşeceği kanalın ID'si (kanala sağ tık > ID Kopyala)
APPLICATION_CHANNEL_ID=

# Onayla/Reddet basabilecek yetkili rolünün ID'si (isteğe bağlı,
# boş bırakırsan sadece "Sunucuyu Yönet" izni olanlar basabilir)
STAFF_ROLE_ID=

# Sunucunun çalışacağı port (çoğu hosting bunu otomatik ayarlar, boş bırakabilirsin)
PORT=3000
